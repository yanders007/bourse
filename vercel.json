{
  "services": {
    "scholarship-backend": {
      "root": ".",
      "buildCommand": "cd backend && composer install --no-dev",
      "entrypoint": "docker/entrypoint.sh"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "scholarship-backend",
        "path": "/$1"
      }
    }
  ]
}
